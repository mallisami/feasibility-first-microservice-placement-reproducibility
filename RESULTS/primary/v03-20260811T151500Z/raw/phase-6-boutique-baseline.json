  "known_defects": [
    {
      "component": "frontend",
      "consequence": "no end-to-end HTTP check through the web frontend.",
      "not_the_cause": [
        "image corruption: re-imported separately, same result",
        "memory limits: tested up to 1Gi, same SIGSEGV",
        "security context: tested with no securityContext, same result",
        "seccomp: tested with Unconfined profile, same result",
        "ASLR: tested with kernel.randomize_va_space=0, same result",
        "NOFILE limits: fixed to 1048576 on all nodes, same result"
      ],
      "root_cause_analysis": {
        "containerd_nofile_fix": "LimitNOFILE=1048576 applied to all three workers (was infinity/1073741816); this fixed the other services but not the frontend",
        "dmesg": "kernel reports 'potentially unexpected fatal signal 11' with ORIG_RAX=0x3b (execve), RAX=-14 (EFAULT), and 'Code: Unable to access opcode bytes' at the crash RIP",
        "interpretation": "the execve syscall for /src/server returns EFAULT on WSL2 kernel 6.18.33.2. The binary is a statically-linked Go 1.22.5 ET_EXEC (non-PIE) ELF, identical to the other 10 Go services that run without issue. The same image runs correctly under Docker Desktop on the same host."
      },
      "scope": "reproduced on all three worker nodes, with and without securityContext, with memory limits from 128Mi to 1Gi, and as bare pods with no probes",
      "status": "unresolvable on WSL2 kernel 6.18.33.2; specific to this Go binary's interaction with the containerd runtime on this kernel version",
      "symptom": "container exits immediately with code 139 (SIGSEGV), producing no log output; startedAt equals finishedAt"
    },
    {
      "component": "all services (intermittent)",
      "consequence": "high restart counts but eventual convergence to running state for 10/11 services. Snapshot readiness varies by capture timing.",
      "root_cause_analysis": {
        "interpretation": "the WSL2 kernel 6.18 containerd runtime intermittently triggers SIGSEGV on execve for container processes. The failure affects Go, Python, and Java binaries. Most services eventually start successfully after retries; the frontend Go binary consistently fails."
      },
      "scope": "dmesg on all three workers shows repeated 'potentially unexpected fatal signal 11' entries. Restart counts range from 2 to 24+ across services. All images run correctly under Docker Desktop.",
      "status": "intermittent; services recover via Kubernetes restart policy. Only frontend is persistently affected.",
      "symptom": "all 11 services experience intermittent SIGSEGV (signal 11) on WSL2 kernel 6.18.33.2 under containerd. Most services recover after several restarts; frontend never recovers."
    }
  ],
