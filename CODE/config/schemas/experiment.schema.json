{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/mape-cap-bplus/experiment.schema.json",
  "title": "MAPE-CAP B+ single-window experiment contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "instance_id",
    "application_file",
    "cluster_file",
    "link_trace_file",
    "scenario_ids",
    "current_placement",
    "relocation_costs",
    "risk"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "instance_id": {
      "type": "string",
      "minLength": 1
    },
    "application_file": {
      "type": "string",
      "minLength": 1
    },
    "cluster_file": {
      "type": "string",
      "minLength": 1
    },
    "link_trace_file": {
      "type": "string",
      "minLength": 1
    },
    "scenario_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "current_placement": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string"
      }
    },
    "relocation_costs": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "cost_units",
          "expected_seconds",
          "uncertainty_units",
          "provenance"
        ],
        "properties": {
          "cost_units": {
            "type": "number",
            "minimum": 0
          },
          "expected_seconds": {
            "type": "number",
            "minimum": 0
          },
          "uncertainty_units": {
            "type": "number",
            "minimum": 0
          },
          "provenance": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "max_relocations": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cvar_quantile",
        "cvar_weight",
        "relocation_weight",
        "slo_slack_weight"
      ],
      "properties": {
        "cvar_quantile": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        },
        "cvar_weight": {
          "type": "number",
          "minimum": 0
        },
        "relocation_weight": {
          "type": "number",
          "minimum": 0
        },
        "slo_slack_weight": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "metadata": {
      "type": "object"
    }
  }
}
