{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/mape-cap-bplus/application.schema.json",
  "title": "MAPE-CAP B+ replica and flow model",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "application_id", "replicas", "flows"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "application_id": {"type": "string", "minLength": 1},
    "replicas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["replica_id", "service_id", "cpu_request", "memory_request_mb"],
        "properties": {
          "replica_id": {"type": "string", "minLength": 1},
          "service_id": {"type": "string", "minLength": 1},
          "cpu_request": {"type": "number", "exclusiveMinimum": 0},
          "memory_request_mb": {"type": "number", "exclusiveMinimum": 0},
          "allowed_nodes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "anti_affinity_group": {"type": ["string", "null"]}
        }
      }
    },
    "flows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["flow_id", "source_replica", "destination_replica", "requests_per_window", "bits_per_window"],
        "properties": {
          "flow_id": {"type": "string", "minLength": 1},
          "source_replica": {"type": "string", "minLength": 1},
          "destination_replica": {"type": "string", "minLength": 1},
          "requests_per_window": {"type": "number", "minimum": 0},
          "bits_per_window": {"type": "number", "minimum": 0},
          "criticality": {"type": "number", "minimum": 0, "default": 1.0},
          "max_expected_latency_ms": {"type": ["number", "null"], "minimum": 0}
        }
      }
    }
  }
}
