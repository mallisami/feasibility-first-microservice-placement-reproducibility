{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/mape-cap-bplus/result.schema.json",
  "title": "MAPE-CAP B+ run result",
  "$defs": {
    "jsonValue": {
      "anyOf": [
        {"type": ["string", "number", "integer", "boolean", "null"]},
        {"type": "array", "items": {"$ref": "#/$defs/jsonValue"}},
        {"type": "object", "additionalProperties": {"$ref": "#/$defs/jsonValue"}}
      ]
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "method", "evidence_type", "placement", "metrics", "provenance"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "method": {"type": "string", "minLength": 1},
    "evidence_type": {"enum": ["controlled-synthetic", "packet-simulation", "network-emulation", "kubernetes-measurement", "derived"]},
    "placement": {"type": "object", "additionalProperties": {"type": "string"}},
    "metrics": {"type": "object", "additionalProperties": {"$ref": "#/$defs/jsonValue"}},
    "provenance": {"type": "object", "additionalProperties": {"$ref": "#/$defs/jsonValue"}}
  }
}
