{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/mape-cap-bplus/link_trace.schema.json",
  "title": "MAPE-CAP B+ directed rack-link scenarios",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "decision_window_seconds", "scenarios"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "decision_window_seconds": {"type": "number", "exclusiveMinimum": 0},
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scenario_id", "weight", "regime_duration_seconds", "links", "conflict_budgets_seconds"],
        "properties": {
          "scenario_id": {"type": "string", "minLength": 1},
          "weight": {"type": "number", "minimum": 0},
          "regime_duration_seconds": {"type": "number", "exclusiveMinimum": 0},
          "intra_rack_latency_ms": {"type": "number", "minimum": 0, "default": 0.2},
          "intra_rack_goodput_bps": {"type": "number", "exclusiveMinimum": 0},
          "conflict_budgets_seconds": {
            "type": "object",
            "additionalProperties": {"type": "number", "minimum": 0}
          },
          "links": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["source_rack", "destination_rack", "latency_ms", "goodput_bps", "available", "path_id", "provenance"],
              "properties": {
                "source_rack": {"type": "string", "minLength": 1},
                "destination_rack": {"type": "string", "minLength": 1},
                "latency_ms": {"type": "number", "minimum": 0},
                "goodput_bps": {"type": "number", "minimum": 0},
                "available": {"type": "boolean"},
                "path_id": {"type": "string", "minLength": 1},
                "conflict_group": {"type": ["string", "null"]},
                "provenance": {"type": "string", "minLength": 1}
              }
            }
          },
          "metadata": {"type": "object"}
        }
      }
    }
  }
}
