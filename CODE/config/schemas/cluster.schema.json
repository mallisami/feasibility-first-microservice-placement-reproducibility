{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/mape-cap-bplus/cluster.schema.json",
  "title": "MAPE-CAP B+ rack and node model",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "cluster_id", "nodes"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "cluster_id": {"type": "string", "minLength": 1},
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["node_id", "rack_id", "cpu_capacity", "memory_capacity_mb"],
        "properties": {
          "node_id": {"type": "string", "minLength": 1},
          "rack_id": {"type": "string", "minLength": 1},
          "cpu_capacity": {"type": "number", "exclusiveMinimum": 0},
          "memory_capacity_mb": {"type": "number", "exclusiveMinimum": 0}
        }
      }
    }
  }
}
